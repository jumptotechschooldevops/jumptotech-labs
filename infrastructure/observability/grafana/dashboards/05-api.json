    },
    {
      "id": 107,
      "type": "timeseries",
      "title": "Verification results",
      "description": "`fail` is a student who has not finished \u2014 the most normal event in the product. Only `error` is an outage.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "sum by (result) (rate(jtt_verification_total[10m])) * 60",
          "legendFormat": "{{result}}",
          "refId": "E"
        }
      ],
      "options": {
        "legend": {
