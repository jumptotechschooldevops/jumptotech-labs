        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "jtt_db_pool_connections{state=\"waiting\"}",
          "legendFormat": "",
          "refId": "D"
