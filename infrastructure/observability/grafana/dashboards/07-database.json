{
  "uid": "jtt-database",
  "title": "JTT \u2014 Database",
  "description": "PostgreSQL reachability, the connection pool, and whether history is actually durable.",
  "tags": [
    "jumptotech",
    "database"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "Deploys / restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "jtt-prometheus"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "changes(jtt_process_start_time_seconds[5m]) > 0",
        "titleFormat": "{{service}} restarted",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 130,
      "type": "stat",
      "title": "Database",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "jtt_db_up",
          "legendFormat": "",
          "refId": "B"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 132,
      "type": "stat",
      "title": "Waiting for a connection",
      "description": "Above zero while the database is answering means the APPLICATION is starved, not that the database is dead. Different incident, different fix.",
