{
  "uid": "jtt-providers",
  "title": "JTT \u2014 Providers",
  "description": "Which substrate can run labs right now, and how much of the catalogue an outage costs.",
  "tags": [
    "jumptotech",
    "providers"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "Deploys / restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "jtt-prometheus"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "changes(jtt_process_start_time_seconds[5m]) > 0",
        "titleFormat": "{{service}} restarted",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 49,
      "type": "timeseries",
      "title": "Availability matrix",
      "description": "One line per provider. AWS reports 0 permanently and by design \u2014 it provisions nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "jtt_provider_available",
          "legendFormat": "{{provider}} ({{implementation}})",
          "refId": "Y"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Probe duration p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(jtt_provider_availability_probe_duration_seconds_bucket[10m])))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "Probe results",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "sum by (provider, result) (rate(jtt_provider_availability_probe_total[10m])) * 60",
          "legendFormat": "{{provider}} {{result}}",
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 56,
      "type": "table",
      "title": "Blast radius \u2014 labs per provider",
      "description": "Pair with the availability matrix: 'docker is down' becomes 'fourteen labs cannot start'.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "jtt_provider_labs_total",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 58,
      "type": "table",
      "title": "Currently unavailable",
      "description": "Filtered to providers that actually back labs, so the architecture-only AWS provider does not sit here forever.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "jtt_provider_available == 0 and on(provider) jtt_provider_labs_total > 0",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}