    {
      "id": 166,
      "type": "timeseries",
      "title": "Authorization decisions",
      "description": "`denied-not-owner` is the session-probing detector.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "sum by (result) (rate(jtt_authz_decisions_total[10m])) * 60",
          "legendFormat": "{{result}}",
          "refId": "L"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
