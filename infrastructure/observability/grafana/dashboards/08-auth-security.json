    {
      "id": 179,
      "type": "timeseries",
      "title": "Attach ownership refusals",
      "description": "The gates that stop one student's terminal reaching another student's sandbox. They hold silently; counting them is what distinguishes 'the boundary was tested' from 'nobody tried'.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
