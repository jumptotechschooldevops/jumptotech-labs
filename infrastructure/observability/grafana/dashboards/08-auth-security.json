{
  "uid": "jtt-security",
  "title": "JTT \u2014 Auth / Security",
  "description": "Identity, authorization decisions, and every boundary refusal the platform makes.",
  "tags": [
    "jumptotech",
    "security"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "Deploys / restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "jtt-prometheus"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "changes(jtt_process_start_time_seconds[5m]) > 0",
        "titleFormat": "{{service}} restarted",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 154,
      "type": "stat",
      "title": "Scope denials (1h)",
      "description": "Should be flat zero forever. Each service holds only the scope secrets it needs, so a denial means a misconfiguration or a probe. There is no benign explanation.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "sum(increase(jtt_sandboxd_scope_denials_total[1h]))",
          "legendFormat": "",
          "refId": "Z"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 156,
      "type": "stat",
      "title": "Ownership denials (1h)",
      "description": "A browser only ever holds its own session id, so this is somebody trying ids that are not theirs.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "sum(increase(jtt_authz_decisions_total{result=\"denied-not-owner\"}[1h]))",
          "legendFormat": "",
          "refId": "B"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
