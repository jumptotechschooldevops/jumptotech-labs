    {
      "id": 48,
      "type": "table",
      "title": "Starts by lab (top 20)",
      "description": "Scope a failure spike here first: one lab, one track, or everything are three different incidents.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "jtt-prometheus"
          },
          "expr": "topk(20, sum by (lab_id, track, outcome) (increase(jtt_lab_start_total[6h])))",
          "legendFormat": "",
          "refId": "V",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}