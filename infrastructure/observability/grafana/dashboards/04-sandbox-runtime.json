    {
      "id": 77,
      "type": "timeseries",
      "title": "Containers held vs sessions active",
      "description": "THE LEAK PANEL. Both sides read from their own source of truth at scrape time, which is what makes the subtraction trustworthy enough to alert on.",
      "datasource": {
        "type": "prometheus",
        "uid": "jtt-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
