{
  "$comment": [
    "BETA-P0-010 — which service receives which secret. The single source of truth.",
    "",
    "Exact allowlists: a service listed with [] receives no secret at all, and a",
    "service that references a secret not listed for it fails the contract. Read by",
    "services/observability/test/compose-secret-distribution.test.ts (hermetic, every",
    "`npm test`) and scripts/check-secret-distribution.mjs (`make secrets-check`, which",
    "resolves the files with `docker compose config`).",
    "",
    "Change this file and the compose files in the same commit, and say why in the",
    "commit message: widening a list hands a credential to one more process.",
    "",
    "`optionalEmpty` names the only secrets that may use `${NAME:-}`. Every other",
    "reference must be `${NAME:?…}`: a secret is never defaulted, and never defaulted",
    "to another secret."
  ],
  "secrets": [
    "TERMINAL_SESSION_SECRET",
    "INTERNAL_SERVICE_SECRET",
    "NAMESPACE_DERIVATION_SECRET",
    "SANDBOXD_ATTACH_SECRET",
    "SANDBOXD_RUNTIME_SECRET",
    "SANDBOXD_DOCKER_SECRET",
    "OIDC_CLIENT_SECRET",
    "POSTGRES_PASSWORD",
    "OBSERVABILITY_SCRAPE_TOKEN",
    "GRAFANA_ADMIN_PASSWORD"
  ],
  "optionalEmpty": ["OIDC_CLIENT_SECRET"],
  "stacks": {
    "base": {
      "files": ["docker-compose.yml"],
      "profiles": [],
      "services": {
        "postgres": ["POSTGRES_PASSWORD"],
        "api": [
          "TERMINAL_SESSION_SECRET",
          "INTERNAL_SERVICE_SECRET",
          "NAMESPACE_DERIVATION_SECRET",
          "OIDC_CLIENT_SECRET",
          "POSTGRES_PASSWORD",
          "OBSERVABILITY_SCRAPE_TOKEN"
        ],
        "terminal": ["TERMINAL_SESSION_SECRET", "INTERNAL_SERVICE_SECRET", "OBSERVABILITY_SCRAPE_TOKEN"],
        "web": []
      }
    },
    "runtime": {
      "files": ["docker-compose.yml", "docker-compose.runtime.yml"],
      "profiles": [],
      "services": {
        "postgres": ["POSTGRES_PASSWORD"],
        "api": [
          "TERMINAL_SESSION_SECRET",
          "INTERNAL_SERVICE_SECRET",
          "NAMESPACE_DERIVATION_SECRET",
          "SANDBOXD_RUNTIME_SECRET",
          "SANDBOXD_DOCKER_SECRET",
          "OIDC_CLIENT_SECRET",
          "POSTGRES_PASSWORD",
          "OBSERVABILITY_SCRAPE_TOKEN"
        ],
        "terminal": [
          "TERMINAL_SESSION_SECRET",
          "INTERNAL_SERVICE_SECRET",
          "SANDBOXD_ATTACH_SECRET",
          "OBSERVABILITY_SCRAPE_TOKEN"
        ],
        "sandboxd": [
          "SANDBOXD_ATTACH_SECRET",
          "SANDBOXD_RUNTIME_SECRET",
          "SANDBOXD_DOCKER_SECRET",
          "NAMESPACE_DERIVATION_SECRET",
          "OBSERVABILITY_SCRAPE_TOKEN"
        ],
        "web": []
      }
    },
    "observability": {
      "files": ["docker-compose.yml", "docker-compose.runtime.yml", "docker-compose.observability.yml"],
      "profiles": ["observability"],
      "services": {
        "postgres": ["POSTGRES_PASSWORD"],
        "api": [
          "TERMINAL_SESSION_SECRET",
          "INTERNAL_SERVICE_SECRET",
          "NAMESPACE_DERIVATION_SECRET",
          "SANDBOXD_RUNTIME_SECRET",
          "SANDBOXD_DOCKER_SECRET",
          "OIDC_CLIENT_SECRET",
          "POSTGRES_PASSWORD",
          "OBSERVABILITY_SCRAPE_TOKEN"
        ],
        "terminal": [
          "TERMINAL_SESSION_SECRET",
          "INTERNAL_SERVICE_SECRET",
          "SANDBOXD_ATTACH_SECRET",
          "OBSERVABILITY_SCRAPE_TOKEN"
        ],
        "sandboxd": [
          "SANDBOXD_ATTACH_SECRET",
          "SANDBOXD_RUNTIME_SECRET",
          "SANDBOXD_DOCKER_SECRET",
          "NAMESPACE_DERIVATION_SECRET",
          "OBSERVABILITY_SCRAPE_TOKEN"
        ],
        "web": [],
        "prometheus": [],
        "alertmanager": [],
        "grafana": ["GRAFANA_ADMIN_PASSWORD"]
      }
    }
  },
  "credentialMounts": {
    "$comment": "Credentials delivered as files rather than variables, and the only service allowed to mount each.",
    "./infrastructure/kind/generated/kubeconfig-internal.yaml": ["api"],
    "./infrastructure/observability/secrets": ["prometheus"],
    "/var/run/docker.sock": ["sandboxd"]
  },
  "publishedPorts": {
    "$comment": [
      "BETA-P0-011 — host ports that carry a credential. Read by the same two enforcers.",
      "",
      "`never`: the sandboxd capability port. Its callers reach it on a private network;",
      "publishing it would put the attach, runtime and Docker endpoints on the host.",
      "`loopbackOnly`: the api and terminal ports (INTERNAL_SERVICE_SECRET) and the three",
      "metrics listeners (OBSERVABILITY_SCRAPE_TOKEN). Published, if at all, on 127.0.0.1."
    ],
    "never": [4002],
    "loopbackOnly": [4000, 4001, 9400, 9401, 9402]
  }
}
