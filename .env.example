# ---------------------------------------------------------------------------
# JumpToTech Labs — local development environment
# Copy to `.env` and adjust if needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Ports (host side) -----------------------------------------------------
WEB_PORT=3000
API_PORT=4000
TERMINAL_PORT=4001

# --- Kubernetes substrate ---------------------------------------------------
# Which Kubernetes substrate backs the `kubernetes` provider. `kind` is the
# only one implemented; `eks` and friends slot in behind the same interface.
#
# NOTE: this is NOT the same thing as a lab's `environment.provider`. That is
# lab metadata (kubernetes | linux | docker | terraform | aws) and selects an
# implementation from the provider registry; this selects the *substrate* the
# Kubernetes implementation runs on. The Docker track is configured separately
# below. Adding `firecracker`, `eks` … later means adding a LabProvider, not
# touching the API or the frontend.
LAB_PROVIDER=kind

# Name of the kind cluster created by `npm run cluster:up`.
LAB_CLUSTER_NAME=jumptotech-labs

# Kubeconfig used by the *api* container only.
#
# PLATFORM-002: the terminal service no longer receives a kubeconfig. This one
# is the platform's own cluster credential — it creates namespaces, applies
# guardrails, and mints per-session ServiceAccount tokens. Students never see it.
#
# Inside Docker Compose this is the `--internal` kubeconfig, whose API server
# address is the control-plane container's DNS name on the shared `kind`
# network. When running the services directly on your host, point this at
# infrastructure/kind/generated/kubeconfig-host.yaml instead.
KUBECONFIG=/etc/jumptotech/kubeconfig.yaml

# Directory containing lab definitions (lab.yaml files).
LABS_DIR=/app/labs

# --- Container-backed sandbox providers (PLATFORM-004) ---------------------
# The Linux and Terraform tracks run one throwaway container per session.
#
# Build the images once on the host:  npm run sandbox:build
# Until they exist (or if no container runtime is reachable) both providers
# report themselves unavailable and their labs are marked as such in the
# catalog — nothing pretends to be runnable.
#
# IMPORTANT: inside the shipped `docker compose` stack these are effectively
# off, because no container there is given access to a container runtime. Run
# the services on your host (npm run dev:api / dev:terminal / dev:web) to use
# the Linux and Terraform tracks. See README → Local development requirements.
LINUX_PROVIDER_ENABLED=true
LINUX_SANDBOX_IMAGE=jumptotech/lab-linux:latest
TERRAFORM_PROVIDER_ENABLED=true
TERRAFORM_SANDBOX_IMAGE=jumptotech/lab-terraform:latest

# The container CLI the orchestrator and the terminal service drive.
SANDBOX_CONTAINER_BINARY=docker

# Per-sandbox resource bounds — the container equivalent of the Kubernetes
# ResourceQuota / LimitRange below.
SANDBOX_CPUS=0.5
SANDBOX_MEMORY=512m
SANDBOX_PIDS_LIMIT=128
SANDBOX_USER=student
SANDBOX_HOME=/home/student
# `none` unless a lab genuinely needs egress. Terraform labs resolve their
# providers from a mirror baked into the image, so they do not.
SANDBOX_NETWORK=none

# May the terminal service attach a PTY to a sandbox container? Off inside the
# compose stack, where it has no runtime access by design.
TERMINAL_CONTAINER_EXEC_ENABLED=true

# The Docker track no longer shares this container-exec substrate: it runs a
# per-session `docker:dind` daemon reached over mutual TLS, configured under
# "Docker track" below. See README → Docker sandbox strategy.
#
# The AWS provider is registered but disabled in code and cannot be switched on
# from here. See README → Future AWS provider architecture.

# --- Terminal session security ---------------------------------------------
# HMAC secret used by the API to sign short-lived terminal session tokens and
# by the terminal service to verify them. The browser cannot open a terminal
# without a token minted by POST /api/labs/:id/start.
# CHANGE THIS. Generate one with:  openssl rand -hex 32
TERMINAL_SESSION_SECRET=dev-only-insecure-secret-change-me

# Lifetime of a terminal session token, in seconds.
TERMINAL_SESSION_TTL_SECONDS=3600

# Shared secret authenticating api <-> terminal service calls (the terminal
# exchanges a session id for that session's kubeconfig). Defaults to
# TERMINAL_SESSION_SECRET so one generated value is enough locally; give it its
# own value in production.
# INTERNAL_SERVICE_SECRET=

# Keys the one-way session-id -> namespace derivation, so a leaked namespace
# name cannot be inverted back into the session id that controls the session.
# Defaults to TERMINAL_SESSION_SECRET.
# NAMESPACE_DERIVATION_SECRET=

# --- Session lifetimes (PLATFORM-002) --------------------------------------
# The absolute ceiling on a lab session. Activity NEVER extends this.
MAX_SESSION_MINUTES=60
# How long a session may sit untouched before cleanup reclaims it.
IDLE_TIMEOUT_MINUTES=20
# How long before idle expiry the UI shows "Continue Lab".
WARNING_MINUTES=5
# Refuse to start a new session beyond this many concurrent ones. A start past
# the limit returns LAB_CAPACITY_REACHED and creates no namespace.
MAX_ACTIVE_SESSIONS=20
# How often the cleanup service sweeps.
CLEANUP_INTERVAL_SECONDS=60
# How long a finished session record is kept for the UI to read.
SESSION_RETENTION_MINUTES=15
# Lifetime of the ServiceAccount token minted for a student's shell. Capped by
# the session's own remaining time, and floored at 10 minutes by Kubernetes.
STUDENT_CREDENTIAL_TTL_SECONDS=3600

# --- Per-session guardrails -------------------------------------------------
# ResourceQuota. Conservative development defaults; tune after load testing.
QUOTA_PODS=15
QUOTA_SERVICES=10
QUOTA_PVCS=5
QUOTA_REQUESTS_CPU=2
QUOTA_REQUESTS_MEMORY=2Gi
QUOTA_LIMITS_CPU=4
QUOTA_LIMITS_MEMORY=4Gi
# LoadBalancer and NodePort Services are pinned to 0 in code and are not
# configurable upward — a lab must never ask the cloud for an address.

# LimitRange. `defaultRequest` is what lets an unqualified
# `kubectl run nginx --image=nginx:stable` satisfy the quota above.
LIMITS_DEFAULT_REQUEST_CPU=50m
LIMITS_DEFAULT_REQUEST_MEMORY=64Mi
LIMITS_DEFAULT_CPU=500m
LIMITS_DEFAULT_MEMORY=512Mi
LIMITS_MAX_CPU=1
LIMITS_MAX_MEMORY=1Gi

# NetworkPolicy. Set false only for a cluster whose CNI cannot enforce policy
# and where you would rather not create objects that do nothing.
NETWORK_POLICY_ENABLED=true
# Cluster ranges, used to allow external egress while blocking pod-to-pod
# traffic into other students' namespaces. These are kind's defaults.
CLUSTER_POD_CIDR=10.244.0.0/16
CLUSTER_SERVICE_CIDR=10.96.0.0/16
ALLOW_EXTERNAL_EGRESS=true

# --- Container-backed sandbox providers (PLATFORM-004) ---------------------
# The Linux and Terraform tracks run one throwaway container per session.
#
# Build the images once on the host:  npm run sandbox:build
# Until they exist (or if no container runtime is reachable) both providers
# report themselves unavailable and their labs are marked as such in the
# catalog — nothing pretends to be runnable.
#
# IMPORTANT: inside the shipped `docker compose` stack these are effectively
# off, because no container there is given access to a container runtime, and
# the Docker socket is never mounted into the terminal service. Run the services
# on your host (npm run dev:api / dev:terminal / dev:web) to use the Linux and
# Terraform tracks. See README → Local development requirements.
LINUX_PROVIDER_ENABLED=true
LINUX_SANDBOX_IMAGE=jumptotech/lab-linux:latest
TERRAFORM_PROVIDER_ENABLED=true
TERRAFORM_SANDBOX_IMAGE=jumptotech/lab-terraform:latest

# The container CLI the orchestrator and the terminal service drive.
SANDBOX_CONTAINER_BINARY=docker

# Per-sandbox resource bounds — the container equivalent of the Kubernetes
# ResourceQuota / LimitRange above.
SANDBOX_CPUS=0.5
SANDBOX_MEMORY=512m
SANDBOX_PIDS_LIMIT=128
SANDBOX_USER=student
SANDBOX_HOME=/home/student
# `none` unless a lab genuinely needs egress. Neither track does: Linux labs are
# solved locally and Terraform labs resolve providers from a baked-in mirror.
SANDBOX_NETWORK=none

# May the terminal service attach a PTY to a sandbox container? Off inside the
# compose stack, where it has no runtime access by design.
TERMINAL_CONTAINER_EXEC_ENABLED=true

# Refuse to create more than this many sandboxes on one host.
LINUX_MAX_SANDBOXES=25

# The unprivileged account every student shell runs as, and its HOME.
LINUX_SHELL_USER=student
LINUX_WORKDIR=/home/student
# LINUX_SHELL_PATH=/bin/bash

# What may be executed inside a sandbox by the verifier. There is no shell here:
# a check names a binary from this list, or runs the student's own script by
# absolute path from SANDBOX_RUNNABLE_ROOTS. Narrow it, never widen it casually.
# SANDBOX_EXEC_ALLOWLIST=test,stat,id,getent,ps,ss,df,du,ls,cat,grep,wc,hostname,readlink,find,sha256sum,head,tail,awk,cut,sort,uniq,uname
# SANDBOX_RUNNABLE_ROOTS=/home/student
SANDBOX_EXEC_TIMEOUT_SECONDS=20
SANDBOX_EXEC_MAX_OUTPUT_KB=512
# Kill an attached PTY after this long with no traffic.
SANDBOX_ATTACH_IDLE_SECONDS=1800

# --- Docker track (PLATFORM-DOCKER) -----------------------------------------
# A Docker lab session gets one `docker:dind` container — a sandbox running its
# own private Docker daemon, with its own image store, container list, volumes
# and networks. `docker ps` in one session cannot show another session's
# containers, because they are registered with a different daemon process.
#
# Set false to serve Kubernetes labs only. Docker labs still load and still
# appear in the catalog; only Start Lab refuses, naming what *is* configured.
# That is the honest behaviour on a host whose Docker daemon the API cannot
# reach.
DOCKER_TRACK_ENABLED=true

# Image providing the isolated daemon.
DOCKER_SANDBOX_IMAGE=docker:27-dind

# Resource controls for one sandbox — and therefore for the whole session:
# every container a student starts is a child of this one process tree, so a
# student cannot escape these by launching more containers.
DOCKER_SANDBOX_MEMORY=2g
DOCKER_SANDBOX_CPUS=2
DOCKER_SANDBOX_PIDS_LIMIT=512

# Advisory ceiling reported to the student. Docker has no per-daemon container
# cap, so this is *not* enforced; memory and pids are the limits that bind.
DOCKER_SANDBOX_MAX_CONTAINERS=10

# User-defined bridge every sandbox joins, so the terminal can reach a session's
# daemon at tcp://lab-<hash>:2376. Reachability is not the security boundary —
# mutual TLS is, and every sandbox mints its own CA at startup.
DOCKER_SANDBOX_NETWORK=jumptotech-sandboxes
DOCKER_SANDBOX_DAEMON_PORT=2376

# How long to wait for a sandbox's daemon to accept commands. dockerd gives its
# managed containerd a fixed 15s to start; on a loaded host that window is
# missed, so the sandbox is given a restart policy and this budget to retry in.
DOCKER_SANDBOX_READY_TIMEOUT_SECONDS=180
DOCKER_SANDBOX_RESTART_ATTEMPTS=5

# Optional pull-through cache for the sandbox daemons. Saves re-pulling lab base
# images per session. An http:// mirror is also passed as --insecure-registry,
# because the daemon otherwise refuses to use it.
# DOCKER_SANDBOX_REGISTRY_MIRROR=http://registry-mirror:5000

# DOCKER_SANDBOX_PRIVILEGED=true
#   Docker-in-Docker cannot run unprivileged: the inner daemon has to create
#   cgroups, mount filesystems, and program iptables. This is the single
#   privileged component in the design, it is created by the platform, and no
#   student process runs inside it — it exists precisely so the *host* Docker
#   socket never has to be exposed to anything a student can reach. Set false
#   only on a host with a rootless alternative. See README → Docker sandbox
#   security for what this does and does not protect against.

# Where the terminal service keeps per-session workspaces — the directory a
# Docker student authors a Dockerfile in and that `docker build` reads as its
# context. Removed when the session ends.
TERMINAL_WORKSPACE_ROOT=/home/student/workspaces

# --- CORS / browser origins -------------------------------------------------
# Comma-separated list of origins allowed to call the API and open terminals.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (baked into the Vite build / dev server) ----------------------
VITE_API_URL=http://localhost:4000
VITE_TERMINAL_WS_URL=ws://localhost:4001

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- PostgreSQL: persistent student progress (PLATFORM-005) -----------------
# Sandboxes stay disposable and their bookkeeping stays in memory. What lives
# here is the part that must survive a student closing the tab: students, lab
# attempts, per-lab progress and hint usage.
#
# `make setup` generates POSTGRES_PASSWORD for you. Nothing in application
# source has a default password, so an unset value fails loudly instead of
# quietly connecting somewhere.
POSTGRES_USER=jumptotech
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=jumptotech_labs
# Host port for psql / migrations. Change it if 5432 is already in use locally.
POSTGRES_PORT=5432

# The api builds its own DATABASE_URL from the three variables above when it
# runs in Docker Compose. Set this only when running the api directly on your
# host (npm run dev:api), pointing at the published port:
# DATABASE_URL=postgresql://jumptotech:dev-only-change-me@localhost:5432/jumptotech_labs

# Apply pending migrations at startup. Forward-only and idempotent — it applies
# the migration files this database has not seen and nothing else. It never
# drops or recreates anything. Set false to migrate from a pipeline instead
# (npm run db:migrate).
DATABASE_AUTO_MIGRATE=true

# Connection pool and safety valves.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# DATABASE_SSL=false

# --- Development student identity (PLATFORM-005) ----------------------------
# ⚠ THIS IS NOT AUTHENTICATION. There is no login yet, so every request is
# attributed to one configured student id. Anyone who can reach the API is that
# student. See README → Security for the full statement of the limitation.
DEV_STUDENT_ID=dev-student-001

# When true, an `x-dev-student-id` header may select a different student — the
# only way to try two students on one laptop before login exists. It also means
# anyone can read anyone's progress, so it is false in code by default and must
# never be enabled on a deployment holding real learner data.
DEV_STUDENT_HEADER_ENABLED=false
