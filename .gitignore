node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo

# Local environment
.env
.env.local
.env.*.local
# Any other environment file (.env.production, .env.prod, …) holds the same
# secrets as .env. Only the template is source.
.env.*
!.env.example

# Generated kubeconfigs — contain client certificates for the local throwaway
# kind cluster. Never commit credentials, even development ones.
infrastructure/kind/generated/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log
npm-debug.log*

# Database backups (BETA-P0-013). They hold every student's data: never commit
# one, wherever it was written. scripts/db-backup.sh defaults to backups/postgres.
/backups/
*.dump
*.dump.sha256
*.dump.partial

# Browser E2E (e2e/stack.sh): per-run generated secrets and Playwright output.
/e2e/.stack/
/e2e/test-results/
/e2e/playwright-report/
